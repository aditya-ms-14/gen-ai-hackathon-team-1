# Copy to .env and fill in. Never commit .env.

# Order the router tries providers in
LLM_PROVIDER_ORDER=gemini,groq,lmstudio

# --- Gemini (primary) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" on flash models (faster, fewer tokens). Leave empty for model default.
GEMINI_THINKING_BUDGET=0

# --- Groq (second) : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LM Studio (local fallback) : Developer tab -> Start Server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model id as shown in LM Studio; leave empty to use whatever model is loaded
LMSTUDIO_MODEL=qwen2.5-3b-instruct
LMSTUDIO_TIMEOUT=120

# --- Retry policy
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE=1
LLM_RATE_LIMIT_COOLDOWN=60
LLM_MAX_TOKENS=4096
