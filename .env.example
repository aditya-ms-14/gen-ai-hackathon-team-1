# Copy to .env and fill in. Never commit .env.
# No keys at all? The app still runs: regex claim parser + template explanations.

# Order the team router (llm_router/) tries providers in
LLM_PROVIDER_ORDER=gemini,groq,lmstudio

# --- Gemini (primary): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" on flash models (faster, fewer tokens). Leave empty for the model default.
GEMINI_THINKING_BUDGET=0
# Used by the built-in fallback router (auditor/llm_router.py)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Groq (second): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LM Studio (local fallback): Developer tab -> Start Server, with a small instruct model loaded
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and takes ~4 s to fail when LM Studio is off
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Model id as shown in LM Studio; leave empty to use whatever model is loaded
LMSTUDIO_MODEL=
LMSTUDIO_TIMEOUT=120

# --- Retry policy (team router)
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE=1
LLM_RATE_LIMIT_COOLDOWN=60
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=20
